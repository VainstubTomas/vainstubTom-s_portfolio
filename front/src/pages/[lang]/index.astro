---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, languages } from '../../i18n/utils';

import HeroIdentity from '../../components/HeroIdentity.astro';
import SocialPill from '../../components/SocialPill.astro'
import SectionTitle from '../../components/SectionTitle.astro';
import GitGraph from '../../components/GitGraph.astro';
import Recommendation from '../../components/Recommendation.astro';
import MainStack from '../../components/MainStack.astro';
import StackMarquee from '../../components/StackMarquee.astro';
import Experience from '../../components/Experience.astro';
import Container from '../../components/Container.astro'
import Projects from '../../components/Projects.astro'
import Contacto from '../../components/Contacto.astro';
import SobreMi from '../../components/SobreMi.astro';

import Linkedin from '../../components/icons/Linkedin.astro';
import GitHub from '../../components/icons/GitHub.astro';
import Mail from '../../components/icons/Mail.astro';
import { EMAIL } from '../../lib/nav';

export function getStaticPaths() {
	return (Object.keys(languages) as (keyof typeof languages)[]).map((lang) => ({
		params: { lang },
	}));
}

const lang = Astro.params.lang as keyof typeof languages;
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('meta.title')} description={t('meta.description')}>
	<main>

		<!-- TEMP: azul (blue-900) en vez de --color-brand. Solo el hero lleva el degradé; se desvanece hacia el negro del resto de la web. -->
		<div class="relative isolate px-4 min-h-svh flex flex-col justify-center">
			<div
				aria-hidden="true"
				class="absolute inset-0 -z-10 [background:radial-gradient(125%_100%_at_50%_10%,#000_40%,var(--color-blue-900)_100%)] [mask-image:linear-gradient(to_bottom,#000_60%,transparent)]"
			></div>
		<Container class="pt-20 pb-40! text-center" id="inicio">
			<HeroIdentity/>
			<h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold pb-3">{t('hero.nombre')}</h1>
			<p class="text-xl lg:text-3xl font-medium text-white/90">{t('hero.rol')}</p>
			<p class="text-base lg:text-xl text-white/60 mt-1">{t('hero.estudio')}</p>
			<nav class="flex gap-4 pt-10 pb-5 flex-wrap justify-center">
				<SocialPill href="https://www.linkedin.com/in/vainstubtomas/">
					<Linkedin class="size-4 lg:size-6"/>
					LinkedIn
				</SocialPill>
				<SocialPill href="https://github.com/VainstubTomas">
					<GitHub class="size-4 lg:size-6"/>
					GitHub
				</SocialPill>
				<SocialPill href="#" data-copy-email={EMAIL} data-toast={t('toast.mail_clipboard')}>
					<Mail class="size-4 lg:size-6"/>
					{EMAIL}
				</SocialPill>
			</nav>
		</Container>
		</div>

		<SobreMi />

		<div class="px-4">
		<section data-reveal class="max-w-5xl mx-auto text-center pb-40 md:pb-52">
			<p class="text-5xl sm:text-6xl md:text-8xl font-extrabold tracking-tight leading-[1.05] text-balance pb-[0.15em] bg-gradient-to-b from-white to-white/40 bg-clip-text text-transparent">{t('intro.titulo')}</p>
			<p class="mt-5 text-xl md:text-3xl font-medium text-white/60">{t('intro.subtitulo')}</p>
		</section>

		<Container id="experiencia">
			<SectionTitle>{t('experiencia.titulo')}</SectionTitle>
			<Experience />
		</Container>

		<section data-reveal class="-mx-4 pt-32 md:pt-44 pb-48 md:pb-64">
			<p class="max-w-4xl mx-auto px-4 mb-16 md:mb-20 text-center text-4xl md:text-6xl font-extrabold tracking-tight leading-[1.1] text-balance pb-[0.15em] bg-gradient-to-b from-white to-white/40 bg-clip-text text-transparent">{t('stack.frase')}</p>
			<MainStack/>
			<div class="mt-14 md:mt-20">
				<StackMarquee/>
			</div>
		</section>

		<Container id="proyectos">
			<SectionTitle>{t('proyectos.title')}</SectionTitle>
			<Projects/>
		</Container>

		<!-- Sin enlace en navbar ni footer (a propósito). -->
		<Container id="recomendaciones" class="pt-24 md:pt-32 pb-40! md:pb-52!">
			<p data-reveal class="mb-20 md:mb-24 lg:-mx-24 text-center text-5xl sm:text-6xl md:text-8xl font-extrabold tracking-tight leading-[1.05] text-balance pb-[0.15em] bg-gradient-to-b from-white to-white/40 bg-clip-text text-transparent">{t('reco.titulo')}</p>
			<!-- Dos columnas en escritorio: git graph a la izquierda, recomendación y pastillas a la derecha. -->
			<div class="grid items-center gap-12 lg:grid-cols-[320px_1fr] lg:gap-14 lg:-mx-[130px]">
				<GitGraph/>
				<div class="w-full max-w-[520px] mx-auto">
				<Recommendation/>
				<ul data-reveal class="mt-8 flex flex-wrap items-center justify-center gap-4">
					<li><span class="rounded-full border border-white/10 bg-white/5 py-2 px-5 text-base lg:text-lg text-white/90 backdrop-blur-xl shadow-[inset_0_1px_0_rgb(255_255_255/0.12)]">Git flow</span></li>
					<li><span class="rounded-full border border-white/10 bg-white/5 py-2 px-5 text-base lg:text-lg text-white/90 backdrop-blur-xl shadow-[inset_0_1px_0_rgb(255_255_255/0.12)]">SCRUM</span></li>
				</ul>
				</div>
			</div>
		</Container>

		<Container id="contacto">
			<Contacto/>
		</Container>
		</div>

	</main>
</Layout>
