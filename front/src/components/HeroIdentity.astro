---
import { useTranslations, getLangFromUrl } from "../i18n/utils"

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Memoji sobre una pastilla glass que hace de "base del torso". -->
<div class="w-fit flex flex-col items-center mb-8">
    <div class="memoji relative w-24 -mb-0.5 aspect-[260/226]" role="img" aria-label={t('hero.foto_alt')}>
        <img class="absolute inset-0 size-full" src="/memoji-body.png" alt="" width="260" height="226" fetchpriority="high">
        <img class="memoji-arm absolute inset-0 size-full" src="/memoji-arm.png" alt="" width="260" height="226" fetchpriority="high">
    </div>

    <span class="relative z-10 inline-flex items-center gap-2 rounded-full border border-emerald-400/25 bg-emerald-400/10 px-4 py-1.5 text-sm lg:text-base font-medium text-emerald-200 backdrop-blur-xl backdrop-saturate-150 shadow-[0_8px_32px_rgb(0_0_0/0.4),inset_0_1px_0_rgb(255_255_255/0.2)]">
        {t('hero.pastilla')}
        <span class="relative flex size-2.5" aria-hidden="true">
            <span class="motion-safe:animate-ping absolute inline-flex size-full rounded-full bg-emerald-400/70"></span>
            <span class="led relative inline-flex size-2.5 rounded-full bg-emerald-400"></span>
        </span>
    </span>
</div>
