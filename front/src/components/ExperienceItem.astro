---
export interface Props{
    title: string
    description: string
    date: string
    company: string
}

const {title, description, date, company} = Astro.props
---

<article
    data-reveal
    class="group relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-white/[0.08] to-white/[0.02] p-6 md:p-8 backdrop-blur-xl backdrop-saturate-150 shadow-[0_8px_32px_rgb(0_0_0/0.35),inset_0_1px_0_rgb(255_255_255/0.12)] transition-colors duration-300 hover:border-white/20"
>
    <!-- Reflejo suave en la esquina, como el brillo del vidrio. -->
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 size-64 rounded-full bg-blue-500/10 blur-3xl"></div>

    <div class="relative">
        <time class="inline-block rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs md:text-sm text-white/70">{date}</time>
        <h3 class="mt-5 text-2xl md:text-3xl font-semibold tracking-tight text-white">{title}</h3>
        <p class="mt-1 text-base md:text-lg font-medium text-title/90">{company}</p>
        <p class="mt-4 text-base md:text-lg leading-relaxed text-white/65 text-pretty">{description}</p>
    </div>
</article>
