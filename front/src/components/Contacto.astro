---
import { useTranslations, getLangFromUrl } from "../i18n/utils"
import { EMAIL } from "../lib/nav"

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<p class="text-xl lg:text-2xl text-wrap max-w-[700px]">
    {t('contacto.texto')}
    <button
        type="button"
        data-copy-email={EMAIL}
        data-toast={t('toast.mail_clipboard')}
        class="text-yellow-100 hover:text-blue-200 transition-colors cursor-pointer"
    >{EMAIL}</button>
</p>
