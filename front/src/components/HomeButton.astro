---
import Home from "./icons/Home.astro";
import { useTranslations, getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const onProjectsPage = Astro.url.pathname.includes("/proyectos");
const href = onProjectsPage ? `/${lang}/#inicio` : "#inicio";
---

<a
    href={href}
    class="group fixed bottom-5 right-5 z-50 flex flex-col items-center justify-center gap-0.5 overflow-hidden rounded-2xl border border-blue-300/25 bg-gradient-to-b from-blue-400/25 to-blue-600/[0.08] px-3.5 py-2.5 text-blue-100/70 backdrop-blur-xl backdrop-saturate-150 shadow-[0_8px_32px_rgb(30_58_138/0.45),inset_0_1px_0_rgb(191_219_254/0.4)] transition-[transform,border-color,background-color] duration-300 hover:-translate-y-0.5 hover:border-blue-200/45 hover:from-blue-400/35"
>
    <span aria-hidden="true" class="pointer-events-none absolute -top-8 -right-8 size-20 rounded-full bg-blue-400/40 blur-2xl"></span>
    <Home class="relative size-5" />
    <span class="relative text-[11px] font-medium leading-none tracking-wide">{t("nav.volver")}</span>
</a>
