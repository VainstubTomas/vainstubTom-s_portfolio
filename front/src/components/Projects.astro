---
import { useTranslations, getLangFromUrl } from "../i18n/utils"
import { getProjects } from "../lib/api";
import TechTag from "./TechTag.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const titleKey = `title_${lang}` as const;
const descKey = `description_${lang}` as const;

// El más reciente (id mayor) primero.
const projects = [...(await getProjects())].sort((a, b) => b.id - a.id).map((p) => ({
    title: p[titleKey],
    description: p[descKey],
    image: p.image,
    tags: p.tags,
}));
---

{
    projects.map(({title, description, tags, image}, i)=>(
        <article data-reveal class="mb-15">
            <h3 class="text-2xl font-semibold text-title mb-2">{title}</h3>
            <p class="text-lg mb-4 text-pretty">{description}</p>
            <ul class="flex gap-2 flex-wrap mb-2">
                {tags.map(tag=>(
                    <li><TechTag name={tag} /></li>
                ))}
            </ul>
            {image && (
                <img
                    class="rounded shadow-2xl shadow-white/10"
                    src={image}
                    alt={`${t('proyectos.alt')} ${title}`}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                >
            )}
        </article>
    ))
}
