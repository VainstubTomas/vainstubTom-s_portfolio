---
import LanguageSelector from "./LanguageSelector.astro"
import { useTranslations, getLangFromUrl } from "../i18n/utils"
import { NAV_LINKS } from "../lib/nav"

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const linkClass = "opacity-70 hover:opacity-100 transition-opacity duration-300";
const cvClass = "inline-block bg-accent text-black font-bold text-lg px-7 py-3 rounded-lg no-underline transition-colors duration-300 hover:bg-black hover:text-white";
---

<header class="flex justify-between items-center px-4 py-5 w-full fixed top-0 left-0 right-0 bg-black/80 backdrop-blur-lg z-50">
    <!-- Menú desktop -->
    <nav class="hidden md:flex flex-row gap-x-10 mx-auto items-center">
        <LanguageSelector />
        {NAV_LINKS.map(({href, key}) => <a href={href} class={linkClass}>{t(key)}</a>)}
        <a href="/files/resume.pdf" target="_blank" class={cvClass}>{t('nav.cv')}</a>
    </nav>

    <!-- Botón hamburguesa (solo móvil) -->
    <button id="menu-toggle" class="md:hidden flex flex-col gap-1.5 p-2 ml-auto z-50" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="menu-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
        <span class="menu-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
        <span class="menu-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
    </button>

    <!-- Menú móvil -->
    <nav id="mobile-menu" class="md:hidden fixed top-[72px] left-0 right-0 bg-black/95 backdrop-blur-lg hidden">
        <div class="flex flex-col items-center gap-6 py-8">
            <LanguageSelector />
            {NAV_LINKS.map(({href, key}) => <a href={href} class={`mobile-link text-lg ${linkClass}`}>{t(key)}</a>)}
            <a href="/files/resume.pdf" target="_blank" class={cvClass}>{t('nav.cv')}</a>
        </div>
    </nav>
</header>

<script>
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const [l1, l2, l3] = Array.from(document.querySelectorAll<HTMLElement>('.menu-line'));

    const setOpen = (open: boolean) => {
        menu?.classList.toggle('hidden', !open);
        toggle?.setAttribute('aria-expanded', String(open));
        l1.style.transform = open ? 'rotate(45deg) translate(5px, 5px)' : 'none';
        l2.style.opacity = open ? '0' : '1';
        l3.style.transform = open ? 'rotate(-45deg) translate(6px, -6px)' : 'none';
    };

    toggle?.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.querySelectorAll('.mobile-link').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
    });
</script>
