---
import LanguageSelector from "./LanguageSelector.astro"
import { useTranslations, getLangFromUrl } from "../i18n/utils"
import { NAV_LINKS, navHref } from "../lib/nav"

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const linkClass = "opacity-80 hover:opacity-100 transition-[opacity,transform] duration-150 ease-out origin-bottom";
const cvClass = "inline-block bg-white/5 text-white font-medium border border-white/10 shadow-[inset_0_1px_0_rgb(255_255_255/0.15)] rounded-xl no-underline transition-colors duration-300 hover:bg-white/10 hover:border-white/20 px-5 py-2";
---

<header class="fixed top-4 inset-x-0 z-50 px-4 flex justify-center pointer-events-none">
    <div
        id="navbar"
        data-dock
        class="glass pointer-events-auto relative w-full md:w-fit rounded-2xl transition-[background-color,padding] duration-300 data-[scrolled=true]:bg-black/40"
    >
        <!-- Dock desktop -->
        <nav class="hidden md:flex flex-row gap-x-6 items-center px-5 py-2.5">
            <LanguageSelector />
            {NAV_LINKS.map((link) => <a href={navHref(lang, link)} data-dock-item class={linkClass}>{t(link.key)}</a>)}
            <a href="/files/resume.pdf" target="_blank" rel="noopener noreferrer" class={cvClass}>{t('nav.cv')}</a>
        </nav>

        <!-- Barra móvil -->
        <div class="md:hidden flex items-center justify-between pl-5 pr-2 py-2">
            <span class="font-semibold text-sm opacity-90">Tomás Vainstub</span>
            <button id="menu-toggle" class="flex flex-col gap-1.5 p-2" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
                <span class="menu-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
                <span class="menu-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
                <span class="menu-line block w-6 h-0.5 bg-white transition-all duration-300"></span>
            </button>
        </div>

        <!-- Menú móvil -->
        <nav id="mobile-menu" class="md:hidden absolute top-full mt-2 inset-x-0 hidden rounded-2xl border border-white/15 bg-neutral-950/95 backdrop-blur-xl shadow-[0_16px_48px_rgb(0_0_0/0.6)]">
            <div class="flex flex-col items-center gap-6 py-8">
                <LanguageSelector />
                {NAV_LINKS.map((link) => <a href={navHref(lang, link)} class={`mobile-link text-lg opacity-80 hover:opacity-100 transition-opacity duration-300`}>{t(link.key)}</a>)}
                <a href="/files/resume.pdf" target="_blank" rel="noopener noreferrer" class="inline-block bg-white/5 text-white font-medium border border-white/10 shadow-[inset_0_1px_0_rgb(255_255_255/0.15)] rounded-xl no-underline transition-colors duration-300 hover:bg-white/10 hover:border-white/20 text-lg px-7 py-3">{t('nav.cv')}</a>
            </div>
        </nav>
    </div>
</header>

<script>
    const navbar = document.getElementById('navbar');
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const [l1, l2, l3] = Array.from(document.querySelectorAll<HTMLElement>('.menu-line'));

    const setOpen = (open: boolean) => {
        menu?.classList.toggle('hidden', !open);
        toggle?.setAttribute('aria-expanded', String(open));
        l1.style.transform = open ? 'rotate(45deg) translate(5px, 5px)' : 'none';
        l2.style.opacity = open ? '0' : '1';
        l3.style.transform = open ? 'rotate(-45deg) translate(6px, -6px)' : 'none';
    };

    toggle?.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.querySelectorAll('.mobile-link').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
    });

    // Al hacer scroll la barra gana opacidad para seguir legible sobre el contenido.
    const onScroll = () => navbar?.setAttribute('data-scrolled', String(window.scrollY > 40));
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
</script>
